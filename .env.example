# Examples only. Set in your shell; .env is NOT automatically loaded.
EMOTION_API_URL=http://127.0.0.1:8000
EMOTION_CHECKPOINT=/absolute/path/to/context_best_best.pt
EMOTION_ASSETS=/absolute/path/to/handoff_assets
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Optional: pin a Hugging Face commit for reproducible embedding model weights.
EMBEDDING_REVISION=
# Both required for an LLM call. Empty configuration produces an explicit template fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
